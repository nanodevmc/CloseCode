{
  "name": "closecode",
  "version": "0.1.0",
  "description": "CloseCode — desktop AI coding agent with your own API keys",
  "main": "./out/main/index.js",
  "author": "CloseCode",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "preview:web": "vite --config vite.preview.config.mts",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "electron-vite build",
    "build:win": "electron-vite build && node scripts/build-installer.mjs",
    "build:dir": "electron-vite build && electron-builder --win --dir",
    "test:agent": "tsx scripts/agent-smoke.ts",
    "test:ui": "node scripts/ui-smoke.mjs"
  },
  "build": {
    "appId": "com.closecode.app",
    "productName": "CloseCode",
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@lydell/node-pty*/**"
    ],
    "win": {
      "icon": "resources/icon.png",
      "electronLanguages": [
        "en-US",
        "ru"
      ],
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "CloseCode-Portable-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/diff": "^7.0.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "undici": "^7.19.2"
  }
}
